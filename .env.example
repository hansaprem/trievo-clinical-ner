# Trievo Clinical NER - Environment Configuration Example
# Copy to .env for local overrides (never commit .env)

# Backend Host & Port
PORT=8000
API_HOST=127.0.0.1
DEVICE=cpu

# Allowed Frontend Origins (comma-separated or single)
FRONTEND_ORIGIN=https://<your-vercel-app>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Path to custom models directory (defaults to ./models)
# MODELS_DIR=./models

# Optional: Hugging Face Model Repository Prefix for production artifact downloading
# HF_MODEL_REPO_PREFIX=hansaprem/trievo-clinical-ner
